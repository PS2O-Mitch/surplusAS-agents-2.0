# Vertex AI / Gemini
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=ps2o-surplusas-api
GOOGLE_CLOUD_LOCATION=us-central1
CONCIERGE_MODEL=gemini-2.5-pro
DISPUTE_TRIAGE_MODEL=gemini-2.5-pro
PRICING_MODEL=gemini-2.5-flash
ONBOARDING_MODEL=gemini-2.5-flash
LISTING_INTAKE_MODEL=gemini-2.5-flash

# Cloud SQL (existing surplusas instance)
CLOUD_SQL_INSTANCE=ps2o-surplusas-api:us-central1:surplusas-db
DB_NAME=surplusas
DB_USER=surplusas_agents_app
DB_PASSWORD=                # populated from Secret Manager in prod

# Agent Engine peer URLs (set by Terraform outputs in prod)
CONCIERGE_AGENT_URL=
PRICING_AGENT_URL=
ONBOARDING_AGENT_URL=
LISTING_INTAKE_AGENT_URL=
DISPUTE_TRIAGE_AGENT_URL=

# Webhooks
WEBHOOK_SIGNING_KEY=        # populated from Secret Manager in prod

# Local dev
LOG_LEVEL=INFO
PORT=8080

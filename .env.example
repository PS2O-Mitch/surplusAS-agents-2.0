# Gemini Developer API (https://aistudio.google.com/apikey — no GCP project needed)
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_API_KEY=

# Model overrides (defaults live in shared/config.py)
CONCIERGE_MODEL=gemini-2.5-pro
DISPUTE_TRIAGE_MODEL=gemini-2.5-pro
PRICING_MODEL=gemini-2.5-flash
ONBOARDING_MODEL=gemini-2.5-flash
LISTING_INTAKE_MODEL=gemini-2.5-flash

# Postgres (Supabase) — use the session-mode pooler or the direct connection.
# Transaction-mode pgBouncer (port 6543) breaks asyncpg prepared statements.
# App runtime uses the surplusas_agents_app role; provisioning scripts need
# the postgres owner DSN.
DATABASE_URL=postgresql://surplusas_agents_app:<password>@db.<project-ref>.supabase.co:5432/postgres

# Webhooks (any long random string; Fly secret in prod)
WEBHOOK_SIGNING_KEY=

# Local dev
LOG_LEVEL=INFO
PORT=8080

# Optional: export OTel spans to any OTLP endpoint (unset = spans stay in-process)
# OTEL_EXPORTER_OTLP_ENDPOINT=

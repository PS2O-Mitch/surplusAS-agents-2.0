# Copy to terraform.tfvars and fill in. All sensitive values land in Secret Manager.
# DO NOT commit the populated terraform.tfvars file.

project_id              = "ps2o-surplusas-api"
region                  = "us-central1"
cloud_sql_instance_name = "surplusas-db"
cloud_sql_database_name = "surplusas"
agents_app_db_user      = "surplusas_agents_app"

# Generate strong random values, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
agents_app_db_password = "REPLACE_ME"
webhook_signing_key    = "REPLACE_ME"

# GitHub fine-grained PAT scoped to read PS2O-Mitch/surplusAS-pricing-intel.
# Used by Cloud Build to fetch the vendor/surplusas-pricing submodule.
# Mirror of the GitHub Actions SUBMODULE_TOKEN secret.
github_submodule_pat = "REPLACE_ME"

# Cloud Monitoring notification channel for the webhook dead-letter alert.
# Create the channel via Console (Monitoring > Alerting > Notification
# Channels) and paste the full resource id. Email channels require email
# verification before the first apply will succeed.
alert_notification_channel_id = "projects/ps2o-surplusas-api/notificationChannels/REPLACE_ME"

# Cloud Build GitHub App installation id (numeric). Install the Cloud
# Build GitHub App on the surplusAS-agents-2.0 repo via the Cloud
# Console "Connect Repository" wizard and copy the installation id.
# Leave blank to skip provisioning Cloud Build triggers.
github_app_installation_id = ""

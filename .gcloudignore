# Controls what `gcloud run deploy --source .` uploads to Cloud Build.
# NOTE: creating this file makes gcloud STOP honoring .gitignore for uploads,
# so the venv/cache exclusions below are repeated here on purpose.
#
# IMPORTANT: do NOT exclude vendor/ — shared/pricing_intel.py imports
# pricing_engine from vendor/surplusas-pricing at runtime.

.git/
.github/
.venv/
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Not needed to build/run the A2A image.
tests/
evals/
infra/
graphify-out/
.claude/

# Secrets / local env / logs / large docs.
.env
.env.*
*.local
deploy_*.log
*.pdf

vendor/**/.git
